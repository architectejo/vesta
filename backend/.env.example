# Copier ce fichier en `.env` (jamais commite) et renseigner des
# valeurs reelles. Aucune valeur ci-dessous n'est utilisable telle
# quelle (CLAUDE.md section 2, regle 12 : aucun secret dans le code).

# --- Django (base.py) ---
# Generer une vraie cle secrete, par ex. :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=changeme-generate-a-real-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (base.py, CDC 7.6) : origine exacte du frontend, jamais de joker ---
# Production : CORS_ALLOWED_ORIGINS=https://vesta.eschoolb.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Proxys de confiance (base.py, CDC 5.1 ; audit de securite du Lot 1) ---
# Nombre de reverse proxys de confiance entre le client et ce processus
# (LiteSpeed/Passenger en production) : n'accorder de confiance a
# `X-Forwarded-For` que pour ce nombre exact de sauts. Defaut 0 : ignore
# totalement cet en-tete (choisi librement par le client), n'utilise que
# l'adresse IP reelle de la connexion. Valeur reelle a confirmer par
# `devops-cpanel` avant mise en production (tache 1.SEC-A).
TRUSTED_PROXY_COUNT=0

# --- Chainage du grand livre financier (base.py, CDC 5.3, tache 1.4b) ---
# Cle(s) HMAC hors base : `identifiant=secret`, separees par des virgules.
# Secret d'au moins 32 caracteres, hexadecimal de preference, par ex. :
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ne JAMAIS retirer une ancienne cle tant que des transactions scellees
# avec elle existent (verification de la chaine). Sans cle, toute ecriture
# financiere est refusee.
LEDGER_HMAC_KEYS=v1=changeme-generate-a-real-random-hex-secret
LEDGER_HMAC_ACTIVE_KEY_ID=v1

# --- Developpement (dev.py) ---
# DJANGO_DEBUG=True

# --- Stockage prive (base.py, CDC 6.7, 8.2 ; ecart bloquant B10, revue
# de conformite fin de Lot 1) : dossier des fichiers sensibles
# (justificatifs, fiches d'adhesion, fichiers d'import CSV, documents
# medicaux), jamais servi directement par le serveur web. En
# developpement, la valeur par defaut (un dossier local separe de
# MEDIA_ROOT) suffit -- ne pas definir cette variable. En production,
# `devops-cpanel` DOIT la faire pointer vers un chemin absolu reellement
# hors de `public_html`.
# PRIVATE_MEDIA_ROOT=/home/compte-cpanel/vesta-private-media

# --- Production (prod.py) : base de donnees MySQL/MariaDB ---
DB_NAME=vesta
DB_USER=vesta
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- Production (prod.py) : email (envoi differe par commande cron) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Production (prod.py) : securite HTTP ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
