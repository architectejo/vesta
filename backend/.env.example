# Copier ce fichier en `.env` (jamais commite) et renseigner les valeurs
# reelles. Aucune valeur ci-dessous n'est utilisable telle quelle
# (CLAUDE.md section 2, regle 12 : aucun secret dans le code).
#
# Les memes variables peuvent etre saisies dans l'interface cPanel
# (Setup Python App > Environment variables) : une variable deja definie
# dans l'environnement n'est jamais ecrasee par ce fichier.
# Sur le serveur : `chmod 600 .env`, et le dossier de l'application doit se
# trouver HORS de public_html (voir docs/guides/exploitation.md).

# =====================================================================
# COMMUN (config/settings/base.py)
# =====================================================================

# Configuration a charger. Production : config.settings.prod (lu par
# manage.py ; passenger_wsgi.py la force de toute facon). Developpement :
# laisser la ligne commentee (config.settings.dev par defaut).
# DJANGO_SETTINGS_MODULE=config.settings.prod

# Cle secrete Django. Generer une valeur aleatoire propre a chaque
# environnement :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Hotes autorises, separes par des virgules. OBLIGATOIRE en production
# (aucune valeur par defaut). Exemple de format : api.exemple.org
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (CDC 7.6) : origine EXACTE de l'interface, schema inclus, sans
# slash final, jamais de joker. Production : l'URL HTTPS de l'interface.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Nombre de reverse proxys de confiance entre le visiteur et Django (CDC
# 5.1 ; ecarts B1/M8). 0 = on ignore X-Forwarded-For et on utilise
# l'adresse reelle de la connexion. Valeur reelle a CONFIRMER sur le
# serveur (voir docs/guides/exploitation.md, section « Proxys »).
TRUSTED_PROXY_COUNT=0

# Chainage du grand livre financier (CDC 5.3). Cle(s) hors base :
# `identifiant=secret`, separees par des virgules ; secret >= 32 caracteres,
# hexadecimal de preference :
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ne JAMAIS retirer ni changer une cle tant que des transactions scellees
# avec elle existent. Sauvegarder cette cle SEPAREMENT de la base : sans
# elle, la chaine ne peut plus etre verifiee.
LEDGER_HMAC_KEYS=
LEDGER_HMAC_ACTIVE_KEY_ID=

# Fichiers prives (justificatifs, fiches d'adhesion, CSV d'import,
# documents medicaux). Jamais servis par le serveur web.
# - Developpement : ne pas definir (dossier local par defaut).
# - Production : OBLIGATOIRE, chemin absolu hors de public_html et hors du
#   dossier de l'application ; le demarrage echoue sinon.
# PRIVATE_MEDIA_ROOT=

# =====================================================================
# DEVELOPPEMENT (config/settings/dev.py) - SQLite, sans variable DB_*
# =====================================================================
# DJANGO_DEBUG=True

# =====================================================================
# PRODUCTION (config/settings/prod.py) - MySQL/MariaDB
# =====================================================================

# Base de donnees creee dans cPanel (« Bases de donnees MySQL »).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Fichiers publics servis par le serveur web (chemins absolus). Par defaut :
# backend/staticfiles et backend/media. En production, les faire pointer
# vers des dossiers sous la racine web du sous-domaine de l'API
# (…/static et …/media). Le dossier PRIVATE_MEDIA_ROOT ne doit PAS etre
# sous MEDIA_ROOT.
# DJANGO_STATIC_ROOT=
# DJANGO_MEDIA_ROOT=

# Email (envoi differe par la commande cron send_notification_emails).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Securite HTTP. Mettre DJANGO_SECURE_SSL_REDIRECT=False UNIQUEMENT en cas
# de boucle de redirection constatee (le .htaccess force deja le HTTPS).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Optionnel : chemin absolu de l'interpreteur Python du virtualenv, si
# cPanel ne lance pas deja l'application dedans (voir passenger_wsgi.py).
# VESTA_PYTHON=

# =====================================================================
# TESTS SUR MYSQL (config/settings/test_mysql.py) - jamais en production
# =====================================================================
# TEST_MYSQL_DB_NAME=
# TEST_MYSQL_DB_USER=
# TEST_MYSQL_DB_PASSWORD=
# TEST_MYSQL_DB_HOST=127.0.0.1
# TEST_MYSQL_DB_PORT=3307
