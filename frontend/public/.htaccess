# Vesta - interface (vesta.eschoolb.com) : build React servi a la racine du
# sous-domaine, LiteSpeed (lit les regles Apache). Ce fichier est copie tel
# quel dans dist/ par Vite (frontend/public/).

# --- Fichiers sensibles : refus explicite, jamais servis ---
<FilesMatch "(^\.|\.(env|sqlite3?|db|sql|log|bak|ini|py|pyc|md|map|csv)$|^(passenger_wsgi|manage)\.py$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS force (HTTP -> HTTPS, redirection permanente)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Dossiers a ne jamais exposer (au cas ou ils seraient copies par erreur)
  RewriteRule ^(private_media|\.git)(/|$) - [F,L]
  RewriteRule (^|/)\.env - [F,L]
  RewriteRule \.sqlite3?$ - [F,L]

  # Fichier ou dossier reel : servi tel quel
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Une ressource avec extension manquante est une vraie 404 (pas index.html),
  # sinon un asset absent renverrait du HTML a la place de JS/CSS.
  RewriteRule \.(js|mjs|css|map|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|json|txt|webmanifest)$ - [R=404,L]

  # Routes React Router (mode history) : tout le reste -> index.html
  RewriteRule ^ /index.html [L]
</IfModule>

# --- En-tetes de securite ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
  # connect-src : l'origine de l'API doit etre autorisee ; elle est identique
  # au domaine parent (voir docs/guides/exploitation.md pour l'adapter).
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://api.vesta.eschoolb.com; connect-src 'self' https://api.vesta.eschoolb.com; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- Cache ---
<IfModule mod_headers.c>
  # Assets versionnes (/assets/) : voir assets/.htaccess (cache long).
  # index.html, service worker, manifeste : jamais mis en cache, pour que
  # chaque deploiement soit vu immediatement (et le retour arriere aussi).
  <FilesMatch "^(index\.html|sw\.js|service-worker\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
